+
+void ForumTopic::preserve_local_read(const ForumTopic &previous) {
+  if (previous.last_read_inbox_message_id_ <= last_read_inbox_message_id_) {
+    return;
+  }
+  if (last_message_id_.is_valid() && previous.last_read_inbox_message_id_ >= last_message_id_) {
+    unread_count_ = 0;
+  } else if (server_last_read_inbox_message_id_ == previous.server_last_read_inbox_message_id_) {
+    // With an unchanged server frontier, new arrivals change the server count by
+    // the same amount. Never subtract the same local reads twice on refresh.
+    auto locally_read_count = max(0, previous.server_unread_count_ - previous.unread_count_);
+    unread_count_ = max(0, server_unread_count_ - locally_read_count);
+  } else if (last_message_id_ <= previous.last_message_id_) {
+    unread_count_ = min(server_unread_count_, previous.unread_count_);
+  }
+  // If another device moved the server frontier AND newer messages arrived,
+  // the exact overlap is unknown. Keep the server count until viewing history
+  // refines it, rather than marking unseen messages read by guessing a delta.
+  // A deleted locally-read message and a new arrival can cancel each other in
+  // the server count. Do not turn an unviewed, still-unread tail into zero merely
+  // because the aggregate delta is zero. History will refine this lower bound.
+  if (unread_count_ == 0 && server_unread_count_ > 0 &&
+      last_message_id_ > previous.last_read_inbox_message_id_) {
+    unread_count_ = 1;
+  }
+  last_read_inbox_message_id_ = previous.last_read_inbox_message_id_;
+}
